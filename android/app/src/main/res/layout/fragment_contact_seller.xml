<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nightmarket_background">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/btnChatBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvChatHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chat with Seller"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/nightmarket_midnight" />

        <ImageView
            android:id="@+id/btnChatRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh" />
    </RelativeLayout>

    <!-- Product Summary Bar (Figma Screen 05) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/nightmarket_border"
        app:strokeWidth="1dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <FrameLayout
                android:id="@+id/chatProductThumbFrame"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_lavender">
                <TextView
                    android:id="@+id/tvChatProductPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎧"
                    android:textSize="20sp" />
                <ImageView
                    android:id="@+id/ivChatProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChatProductTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sony WH-CH720N"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/nightmarket_midnight" />

                <TextView
                    android:id="@+id/tvChatProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹4,200 · Like new"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnViewListing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View listing →"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progressBarChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- Chat Error State -->
    <LinearLayout
        android:id="@+id/layoutChatError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_warning_box"
        android:padding="12dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvChatErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to connect to chat"
            android:textSize="12sp"
            android:textColor="@color/nightmarket_warning_text"
            android:gravity="center" />

        <Button
            android:id="@+id/btnChatRetry"
            style="@style/Widget.NightMarket.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:text="Retry"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Chat Scroll Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatMessagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Date Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_rounded_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="CAMPUS CHAT"
                android:textSize="10sp"
                android:textColor="@color/nightmarket_text_muted" />

            <!-- Seller Incoming Message 1 (Default greeting) -->
            <LinearLayout
                android:id="@+id/layoutSellerInitialContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChatSellerAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_lavender"
                    android:gravity="center"
                    android:text="A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/nightmarket_midnight" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="48dp"
                    android:background="@drawable/bg_chat_incoming"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSellerInitialMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hey! Thanks for your interest in this listing."
                        android:textSize="13sp"
                        android:textColor="@color/nightmarket_text_primary" />

                    <TextView
                        android:id="@+id/tvSellerInitialTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="Seller"
                        android:textSize="9sp"
                        android:textColor="@color/nightmarket_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chat Empty State -->
            <LinearLayout
                android:id="@+id/layoutChatEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_badge_lime"
                    android:gravity="center"
                    android:text="💬"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvChatEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Start the conversation"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/nightmarket_midnight" />

                <TextView
                    android:id="@+id/tvChatEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Ask about availability, pickup spot, or negotiate the price."
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_text_secondary" />
            </LinearLayout>

            <!-- Dynamic Messages List -->
            <LinearLayout
                android:id="@+id/layoutDynamicMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Safety Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_warning_box"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay safe on campus"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/nightmarket_warning_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Meet in public places and inspect before paying."
                        android:textSize="11sp"
                        android:textColor="@color/nightmarket_warning_text" />
                </LinearLayout>
            </LinearLayout>

            <!-- Direct Contact Methods (Intent fallbacks) -->
            <LinearLayout
                android:id="@+id/layoutChatDirectButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnChatCall"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="📞 Call"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_midnight"
                    app:strokeColor="@color/nightmarket_border" />

                <Button
                    android:id="@+id/btnChatSMS"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="💬 SMS"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_midnight"
                    app:strokeColor="@color/nightmarket_border" />

                <Button
                    android:id="@+id/btnChatEmail"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="✉️ Email"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_midnight"
                    app:strokeColor="@color/nightmarket_border" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Quick Replies Bar (Figma Screen 05) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK REPLIES"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/nightmarket_text_muted" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipReplyAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Still available?"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_text_primary" />

                <TextView
                    android:id="@+id/chipReplyWhere"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Where to meet?"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_text_primary" />

                <TextView
                    android:id="@+id/chipReplyPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Is price negotiable?"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_text_primary" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Message Input Bar (Figma Screen 05) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/white">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="Message…"
            android:textColorHint="@color/nightmarket_text_hint"
            android:textColor="@color/nightmarket_text_primary"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_lime"
            android:padding="9dp"
            android:src="@drawable/ic_send"
            app:tint="@color/nightmarket_midnight"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
