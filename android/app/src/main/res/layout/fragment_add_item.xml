<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/nightmarket_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/btnAddBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Sell an item"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_midnight" />
        </RelativeLayout>

        <!-- Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp">

            <!-- Subtitle Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Give your item a\nsecond life."
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_midnight"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="A few details help the right buyer find it."
                android:textSize="13sp"
                android:textColor="@color/nightmarket_text_secondary" />

            <!-- PHOTOS Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PHOTOS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/nightmarket_text_muted" />

            <FrameLayout
                android:id="@+id/btnUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dashed_border">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/nightmarket_midnight"
                        android:contentDescription="Add Photo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Add photos of your item"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/nightmarket_midnight" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Up to 5 photos · Clear, well-lit images"
                        android:textSize="11sp"
                        android:textColor="@color/nightmarket_text_muted" />
                </LinearLayout>
            </FrameLayout>

            <!-- ITEM TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="ITEM TITLE *"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/nightmarket_text_muted" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit_text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="e.g. Scientific calculator"
                android:textColorHint="@color/nightmarket_text_hint"
                android:textColor="@color/nightmarket_text_primary"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- CATEGORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CATEGORY *"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/nightmarket_text_muted" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit_text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <!-- PRICE AND CONDITION ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Price -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRICE (₹) *"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/nightmarket_text_muted" />

                    <EditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edit_text"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:hint="0.00"
                        android:textColorHint="@color/nightmarket_text_hint"
                        android:textColor="@color/nightmarket_text_primary"
                        android:textSize="14sp"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <!-- Condition -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONDITION *"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/nightmarket_text_muted" />

                    <Spinner
                        android:id="@+id/spinnerCondition"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edit_text"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DESCRIPTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DESCRIPTION *"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/nightmarket_text_muted" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit_text"
                android:padding="12dp"
                android:gravity="top|start"
                android:hint="Share condition, age, accessories, and anything a buyer should know…"
                android:textColorHint="@color/nightmarket_text_hint"
                android:textColor="@color/nightmarket_text_primary"
                android:textSize="14sp" />

            <!-- SELLER CONTACT SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="YOUR CONTACT DETAILS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/nightmarket_text_muted" />

            <EditText
                android:id="@+id/etSellerName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit_text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Your Name (e.g. Aarav Sharma)"
                android:textColorHint="@color/nightmarket_text_hint"
                android:textColor="@color/nightmarket_text_primary"
                android:textSize="14sp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etSellerPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Phone number (e.g. 9876543210)"
                android:textColorHint="@color/nightmarket_text_hint"
                android:textColor="@color/nightmarket_text_primary"
                android:textSize="14sp"
                android:inputType="phone"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etSellerEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Email address (e.g. student@univ.edu)"
                android:textColorHint="@color/nightmarket_text_hint"
                android:textColor="@color/nightmarket_text_primary"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etMeetupArea"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Campus meetup spot (e.g. Library Entrance)"
                android:textColorHint="@color/nightmarket_text_hint"
                android:textColor="@color/nightmarket_text_primary"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- Negotiable Checkbox -->
            <CheckBox
                android:id="@+id/cbNegotiable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Open to offers / negotiable"
                android:textColor="@color/nightmarket_text_secondary"
                android:textSize="13sp" />

            <!-- Safety Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_badge_mint"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/nightmarket_active_badge"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Meet safely at a public campus spot"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_safety_text" />
            </LinearLayout>

            <!-- Loading Progress -->
            <ProgressBar
                android:id="@+id/progressBarAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/nightmarket_midnight"
                android:visibility="gone" />

            <!-- Publish Button (Figma Screen 03 Bottom CTA) -->
            <Button
                android:id="@+id/btnPublish"
                style="@style/Widget.NightMarket.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Publish listing →"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
