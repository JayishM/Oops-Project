<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/nightmarket_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top Bar: Back, Title, Favorite -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Item details"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_midnight" />

            <ImageView
                android:id="@+id/btnDetailSave"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:padding="6dp"
                android:src="@drawable/ic_nav_saved"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save" />
        </RelativeLayout>

        <!-- Product Image / Artwork Area -->
        <FrameLayout
            android:id="@+id/detailArtworkFrame"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge_lavender">

            <TextView
                android:id="@+id/tvDetailArtworkPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="72sp"
                android:text="🎧" />

            <ImageView
                android:id="@+id/ivDetailProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Condition Pill -->
            <TextView
                android:id="@+id/tvDetailConditionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="14dp"
                android:background="@drawable/bg_badge_lime"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="LIKE NEW"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_midnight" />
        </FrameLayout>

        <!-- Title, Price, Category Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_midnight"
                tools:text="Sony WH-CH720N" />

            <!-- Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/nightmarket_midnight"
                    tools:text="₹4,200" />

                <TextView
                    android:id="@+id/tvDetailSavingsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_lime"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="OFFER OK"
                    android:textColor="@color/nightmarket_midnight"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="@color/nightmarket_text_muted"
                tools:text="Electronics / Headphones" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/nightmarket_border" />

        <!-- About this item -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About this item"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/nightmarket_midnight" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/nightmarket_text_secondary"
                tools:text="Noise cancelling headphones in excellent condition. Includes original case and cable. Used gently for one semester." />

            <TextView
                android:id="@+id/tvCategorySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_mint"
                android:padding="12dp"
                android:textSize="12sp"
                android:textColor="@color/nightmarket_safety_text"
                android:visibility="gone"
                tools:text="Course: CS301 | Edition: 4th" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/nightmarket_border" />

        <!-- Seller Info Card (Matching Figma Screen 02) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/nightmarket_border"
            app:strokeWidth="1dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Seller Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar -->
                    <TextView
                        android:id="@+id/tvSellerAvatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_badge_lavender"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@color/nightmarket_midnight"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSellerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aarav Sharma"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/nightmarket_midnight" />

                        <TextView
                            android:id="@+id/tvSellerCampus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Campus student · 4.8 ★"
                            android:textSize="12sp"
                            android:textColor="@color/nightmarket_text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Usually replies in a few hours"
                    android:textSize="12sp"
                    android:textColor="@color/nightmarket_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pickup Location Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nightmarket_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PICKUP / MEETUP SPOT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/nightmarket_text_muted" />

                <TextView
                    android:id="@+id/tvMeetupLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Campus Center · Public Area"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/nightmarket_midnight" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Safety Warning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_mint"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Meet safely at a well-lit campus location and inspect the item before paying."
                android:textSize="12sp"
                android:textColor="@color/nightmarket_safety_text" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp">

            <!-- Primary Contact: Message Seller (Figma Screen 02 Bottom CTA) -->
            <Button
                android:id="@+id/btnMessageSeller"
                style="@style/Widget.NightMarket.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Message seller →"
                android:textSize="15sp" />

            <!-- Direct Contact Row (Call / SMS / Email) -->
            <LinearLayout
                android:id="@+id/layoutDirectContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCallSeller"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📞 Call"
                    android:textAllCaps="false"
                    android:textColor="@color/nightmarket_midnight"
                    app:strokeColor="@color/nightmarket_border" />

                <Button
                    android:id="@+id/btnEmailSeller"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="✉️ Email"
                    android:textAllCaps="false"
                    android:textColor="@color/nightmarket_midnight"
                    app:strokeColor="@color/nightmarket_border" />
            </LinearLayout>

            <!-- Mark as Sold Button -->
            <Button
                android:id="@+id/btnMarkSold"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Mark this item as sold"
                android:textAllCaps="false"
                android:textColor="@color/nightmarket_text_secondary"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
