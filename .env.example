# NightMarket Spring Boot backend configuration
# Copy this file to .env and edit the values you need.
PORT=8080
SEED_DATA_ENABLED=true
UPLOAD_DIR=./uploads

# Option A: local MongoDB Community Server (default fallback)
# MONGODB_URI=mongodb://localhost:27017/nightmarket

# Option B: MongoDB Atlas (replace with your own connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ajyqhbb.mongodb.net/nightmarket?retryWrites=true&w=majority
# URL-encode reserved characters in your password. Do not commit .env.
